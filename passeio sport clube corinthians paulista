<!-- =====================================================
     JAVASCRIPT
===================================================== -->

<script>


/* =====================================================
   FOTOS
===================================================== */

function fecharTodasAsFotos() {

    document
        .getElementById("paginaEstadio")
        .classList.remove("ativa");

    document
        .getElementById("paginaJogo")
        .classList.remove("ativa");

    document
        .getElementById("paginaPenaltis")
        .classList.remove("ativa");

    document
        .getElementById("paginaClassificacao")
        .classList.remove("ativa");

}


function abrirFoto(id) {

    document
        .getElementById("paginaPrincipal")
        .style.display = "none";

    fecharTodasAsFotos();

    const pagina =
        document.getElementById(id);

    pagina.classList.add("ativa");

    pagina
        .querySelector(".voltar")
        .focus();

    window.scrollTo(0,0);

}


function abrirEstadio() {

    abrirFoto("paginaEstadio");

}


function abrirJogo() {

    abrirFoto("paginaJogo");

}


function abrirPenaltis() {

    abrirFoto("paginaPenaltis");

}


function abrirClassificacao() {

    abrirFoto("paginaClassificacao");

}


function voltarPrincipal() {

    fecharTodasAsFotos();

    document
        .getElementById("paginaPrincipal")
        .style.display = "block";

    window.scrollTo(0,0);

}


/* =====================================================
   TECLADO
===================================================== */

function ativarCard(evento, funcao) {

    if (
        evento.key === "Enter" ||
        evento.key === " "
    ) {

        evento.preventDefault();

        funcao();

    }

}


/* =====================================================
   PAINEL
===================================================== */

const botao =
    document.getElementById(
        "botaoAcessibilidade"
    );

const painel =
    document.getElementById(
        "painelAcessibilidade"
    );


botao.addEventListener(
    "click",
    function() {

        const aberto =
            painel
                .classList
                .toggle("aberto");

        botao.setAttribute(
            "aria-expanded",
            aberto
        );

    }
);


/* =====================================================
   PREFERÊNCIAS
===================================================== */

const classesAcessibilidade = [

    "modo-autismo",

    "modo-calmo",

    "texto-grande",

    "alto-contraste",

    "botoes-grandes",

    "modo-leitura",

    "modo-dislexia",

    "baixa-visao",

    "deficiencia-fisica",

    "modo-surdez"

];


function salvarPreferencias() {

    classesAcessibilidade.forEach(
        function(nome) {

            localStorage.setItem(
                nome,
                document.body
                    .classList
                    .contains(nome)
            );

        }
    );

}


function carregarPreferencias() {

    classesAcessibilidade.forEach(
        function(nome) {

            if (
                localStorage.getItem(nome)
                === "true"
            ) {

                document.body
                    .classList
                    .add(nome);

            }

        }
    );

}


/* =====================================================
   AUTISMO
===================================================== */

function alternarAutismo() {

    document.body
        .classList
        .toggle("modo-autismo");

    salvarPreferencias();

}


/* =====================================================
   MODO CALMO
===================================================== */

function alternarModoCalmo() {

    document.body
        .classList
        .toggle("modo-calmo");

    salvarPreferencias();

}


/* =====================================================
   DISLEXIA
===================================================== */

function alternarDislexia() {

    document.body
        .classList
        .toggle("modo-dislexia");

    salvarPreferencias();

}


/* =====================================================
   TEXTO GRANDE
===================================================== */

function alternarTextoGrande() {

    document.body
        .classList
        .toggle("texto-grande");

    document.body
        .classList
        .add("botoes-grandes");

    salvarPreferencias();

}


/* =====================================================
   BAIXA VISÃO
===================================================== */

function alternarBaixaVisao() {

    document.body
        .classList
        .toggle("baixa-visao");

    document.body
        .classList
        .add("alto-contraste");

    salvarPreferencias();

}


/* =====================================================
   CONTRASTE
===================================================== */

function alternarContraste() {

    document.body
        .classList
        .toggle("alto-contraste");

    salvarPreferencias();

}


/* =====================================================
   BOTÕES GRANDES
===================================================== */

function alternarBotoes() {

    document.body
        .classList
        .toggle("botoes-grandes");

    salvarPreferencias();

}


/* =====================================================
   DEFICIÊNCIA FÍSICA
===================================================== */

function alternarDeficienciaFisica() {

    document.body
        .classList
        .toggle("deficiencia-fisica");

    document.body
        .classList
        .add("botoes-grandes");

    salvarPreferencias();

}


/* =====================================================
   LEITURA
===================================================== */

function alternarLeitura() {

    document.body
        .classList
        .toggle("modo-leitura");

    salvarPreferencias();

}


/* =====================================================
   SURDEZ
===================================================== */

function alternarSurdez() {

    document.body
        .classList
        .toggle("modo-surdez");

    salvarPreferencias();

}


/* =====================================================
   LEITOR DE TEXTO
===================================================== */

function lerTextoSelecionado() {

    if (
        !("speechSynthesis" in window)
    ) {

        alert(
            "Seu navegador não possui leitura de texto."
        );

        return;

    }


    const texto =
        window
            .getSelection()
            .toString()
            .trim();


    if (!texto) {

        alert(
            "Selecione um texto primeiro."
        );

        return;

    }


    window
        .speechSynthesis
        .cancel();


    const fala =
        new SpeechSynthesisUtterance(
            texto
        );


    fala.lang = "pt-BR";

    fala.rate = .8;

    fala.pitch = 1;


    window
        .speechSynthesis
        .speak(fala);

}


/* =====================================================
   TECLA ESC
===================================================== */

document.addEventListener(
    "keydown",
    function(evento) {

        if (
            evento.key === "Escape"
        ) {

            if (
                painel
                    .classList
                    .contains("aberto")
            ) {

                painel
                    .classList
                    .remove("aberto");

                botao.setAttribute(
                    "aria-expanded",
                    "false"
                );

            }
            else {

                voltarPrincipal();

            }

        }

    }
);


/* =====================================================
   RESTAURAR
===================================================== */

function restaurarAcessibilidade() {

    classesAcessibilidade.forEach(
        function(nome) {

            document.body
                .classList
                .remove(nome);

            localStorage.removeItem(nome);

        }
    );

}


/* =====================================================
   INICIAR
===================================================== */

carregarPreferencias();

</script>


